    "/v1/transactions/status": {
      "post": {
        "summary": "Verify transaction and fee receipt; never broadcast",
        "operationId": "transactions_status_post",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "unknown",
                        "pending",
                        "confirming",
                        "reverted",
                        "confirmed"
                      ]
                    },
                    "feePaidWei": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "payouts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{64}$"
                    },
                    "block": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "feePaidWei"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Typed error. 400 validation; 401 key; 409 preflight/nonce/expiry; 429 rate limit; 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tracking": {
                    "type": "string",
                    "description": "Opaque signed token, bound to your partner key. Never edit."
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                },
                "required": [
                  "tracking",
                  "hash"
                ]
              }
            }
          }
        }
      }
    },
    "/registration/config": {
      "get": {
        "summary": "Free off-chain registration policy and optional wallet key status",
        "operationId": "registration_config_get",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "offchain"
                    },
                    "chainId": {
                      "const": 4663
                    },
                    "address": {
                      "type": "null"
                    },
                    "codeHash": {
                      "type": "null"
                    },
                    "feeWei": {
                      "const": "0"
                    },
                    "feeEth": {
                      "const": "0"
                    },
                    "receiver": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "confirmations": {
                      "const": 0
                    },
                    "requesterKey": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^0x[0-9a-fA-F]{64}$",
                      "description": "Stable backend developer ID; not an on-chain credential."
                    },
                    "hasApiKey": {
                      "type": "boolean"
                    },
                    "request": {
                      "type": "null"
                    },
                    "executionFee": {
                      "type": "object",
                      "properties": {
                        "wei": {
                          "const": "10000000000000"
                        },
                        "asset": {
                          "const": "ETH"
                        },
                        "recipient": {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$"
                        }
                      },
                      "required": [
                        "wei",
                        "asset",
                        "recipient"
                      ]
                    }
                  },
                  "required": [
                    "mode",
                    "chainId",
                    "address",
                    "codeHash",
                    "feeWei",
                    "feeEth",
                    "receiver",
                    "confirmations",
                    "requesterKey",
                    "hasApiKey",
                    "request",
                    "executionFee"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 signature/session invalid, expired or used; 409 key exists or no active key; 429 rate limit; 503 registration unavailable."
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "wallet",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ]
      }
    },
    "/registration/challenge": {
