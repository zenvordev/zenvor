        "summary": "Request a five-minute, wallet-bound authorization challenge",
        "operationId": "registration_challenge_post",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "challenge",
                    "message",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 signature/session invalid, expired or used; 409 key exists or no active key; 429 rate limit; 503 registration unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wallet": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "issue",
                      "rotate",
                      "revoke"
                    ]
                  }
                },
                "required": [
                  "wallet",
                  "action"
                ]
              }
            }
          }
        }
      }
    },
    "/registration/authenticate": {
      "post": {
        "summary": "Consume a wallet signature and return a 30-minute session",
        "operationId": "registration_authenticate_post",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "string"
                    },
                    "wallet": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "expiresInSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "session",
                    "wallet",
                    "action",
                    "expiresInSeconds"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 signature/session invalid, expired or used; 409 key exists or no active key; 429 rate limit; 503 registration unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challenge": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  }
                },
                "required": [
                  "challenge",
                  "signature"
                ]
              }
            }
          }
        }
      }
    },
    "/registration/key": {
      "post": {
        "summary": "Issue, rotate or revoke an API key using a single-use wallet-authenticated session",
        "operationId": "registration_key_post",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiKey": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "wallet": {
                      "type": "string"
                    },
                    "requesterKey": {
                      "type": "string"
                    },
                    "revoked": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "apiKey",
                    "wallet",
                    "requesterKey",
                    "revoked",
                    "message"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 signature/session invalid, expired or used; 409 key exists or no active key; 429 rate limit; 503 registration unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session": {
                    "type": "string"
                  }
                },
                "required": [
                  "session"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/erc20/token": {
      "get": {
        "summary": "Discover an imported ERC-20 token and optional sender balance",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          {
            "name": "sender",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chain 4663, token identity including symbol, decimals and address; optional balanceRaw string."
          },
          "400": {
            "description": "Invalid or incompatible token"
          }
        }
      }
    },
    "/v1/transactions/track": {
      "post": {
        "summary": "Persist a broadcast execution hash for confirmation and usage counting",
        "description": "Register once after wallet broadcast. No server signing, broadcasting or block scanning. Existing status requests also enroll hashes. Retry registration, never the wallet execution, if registration fails.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tracking",
                  "hash"
                ],
                "properties": {
                  "tracking": {
                    "type": "string"
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable registration accepted; returns registered:true, hash and state (queued, confirmed, reverted, failed or expired)."
          },
          "429": {
            "description": "Pending queue limit reached; retry registration later."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PartnerKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "QuoteInput": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sender": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "seed": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "method": {
                "const": "abstraction"
              },
              "recipient": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "amount": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              },
              "asset": {
                "type": "string",
                "enum": [
                  "ETH"
                ],
                "default": "ETH",
                "description": "Omission preserves ETH behavior."
              }
            },
            "required": [
              "method",
              "sender",
              "recipient",
              "amount"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sender": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "seed": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "method": {
                "const": "mesh"
              },
              "recipient": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "amount": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              },
              "asset": {
                "type": "string",
                "enum": [
                  "ETH"
                ],
                "default": "ETH",
                "description": "Omission preserves ETH behavior."
              }
            },
            "required": [
              "method",
              "sender",
              "recipient",
              "amount"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sender": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "seed": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "method": {
                "const": "multisend"
              },
              "recipients": {
                "type": "array",
                "minItems": 2,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                }
              },
              "route": {
                "enum": [
                  "direct",
                  "abstraction",
                  "mesh"
                ],
                "default": "abstraction"
              },
              "allocation": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "fixed"
                      },
                      "amount": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
                      }
                    },
                    "required": [
                      "mode",
                      "amount"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "random"
                      },
                      "min": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
                      },
                      "max": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
                      }
                    },
                    "required": [
                      "mode",
                      "min",
                      "max"
                    ]
                  }
                ]
              },
              "asset": {
                "type": "string",
                "enum": [
                  "ETH"
                ],
                "default": "ETH",
                "description": "Omission preserves ETH behavior."
              }
            },
            "required": [
              "method",
              "sender",
              "recipients",
              "allocation"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sender": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "seed": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "method": {
                "const": "rwa"
              },
              "recipient": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "symbol": {
                          "enum": [
                            "NVDA",
                            "AAPL",
                            "TSLA",
                            "MSFT",
                            "AMZN",
                            "GOOGL",
                            "META",
                            "SPY",
                            "MSTR",
                            "QQQ",
                            "AMD"
                          ]
