{
  "openapi": "3.1.0",
  "info": {
    "title": "Zenvor Partner API",
    "version": "1.1.0",
    "description": "Zenvor Developer API. Free off-chain wallet-signature registration issues API keys; no registry contract or registration payment is required. Partner API on chain 4663. ETH/USDG Abstraction, Reactive Mesh and Multi-send; omitted asset defaults to ETH. USDG uses 6 decimals, minimum combined 0.001024, one exact approval, and abstraction/mesh multi-send routes. Flat 0.00001 ETH per successful execution; gas extra and approval fee-free. USDG needs the updated fee bundle and SDK 0.1.2; check /v1/features transferAssets before use. RWA baskets remain limited to 10 of 11 listed stock/ETF assets, excluding USDG. Invoice endpoints are a separate wallet-signed service. Generic ERC20 supports single-recipient abstraction by token contract address, metadata and optional balance discovery, 0\u201336 decimals and a 1024 raw-unit minimum. Check ERC20 in features before use. SDK 0.1.3 adds the typed integration; mesh, multi-send and invoices are not enabled for imported tokens."
  },
  "servers": [
    {
      "url": "https://znvr.app/api",
      "description": "Production API"
    },
    {
      "url": "http://127.0.0.1:3100",
      "description": "Local development API"
    }
  ],
  "security": [
    {
      "PartnerKey": []
    }
  ],
